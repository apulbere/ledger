{
  "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
  "database.hostname": "journal-postgres",
  "database.port": "5432",
  "database.user": "debezium_user",
  "database.password": "debezium_pass",
  "database.dbname": "journal",
  "plugin.name": "pgoutput",
  "slot.name": "journal_cdc",
  "publication.name": "journal_cdc",
  "publication.autocreate.mode": "disabled",
  "table.include.list": "journal.transaction,journal.balance",
  "topic.prefix": "ledger",
  "snapshot.mode": "initial",
  "tombstones.on.delete": "false",

  "transforms": "unwrap,transactionKey,transactionValue,balanceKey,balanceValue",
  "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
  "transforms.unwrap.delete.tombstone.handling.mode": "drop",
  "transforms.transactionKey.type": "org.apache.kafka.connect.transforms.SetSchemaMetadata$Key",
  "transforms.transactionKey.schema.name": "ledger.journal.events.TransactionKey",
  "transforms.transactionKey.predicate": "transactionTopic",
  "transforms.transactionValue.type": "org.apache.kafka.connect.transforms.SetSchemaMetadata$Value",
  "transforms.transactionValue.schema.name": "ledger.journal.events.TransactionPosted",
  "transforms.transactionValue.predicate": "transactionTopic",
  "transforms.balanceKey.type": "org.apache.kafka.connect.transforms.SetSchemaMetadata$Key",
  "transforms.balanceKey.schema.name": "ledger.journal.events.BalanceKey",
  "transforms.balanceKey.predicate": "balanceTopic",
  "transforms.balanceValue.type": "org.apache.kafka.connect.transforms.SetSchemaMetadata$Value",
  "transforms.balanceValue.schema.name": "ledger.journal.events.BalanceChanged",
  "transforms.balanceValue.predicate": "balanceTopic",
  "predicates": "transactionTopic,balanceTopic",
  "predicates.transactionTopic.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
  "predicates.transactionTopic.pattern": "ledger\\.journal\\.transaction",
  "predicates.balanceTopic.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
  "predicates.balanceTopic.pattern": "ledger\\.journal\\.balance",

  "topic.creation.default.partitions": "1",
  "topic.creation.default.replication.factor": "1",
  "topic.creation.default.cleanup.policy": "delete",
  "topic.creation.default.retention.ms": "-1",
  "topic.creation.default.retention.bytes": "-1"
}
