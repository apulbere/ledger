{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-docs-before-archive.py\"",
            "timeout": 15,
            "statusMessage": "Checking living docs before archive"
          }
        ]
      }
    ]
  }
}
